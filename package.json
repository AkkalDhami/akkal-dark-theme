{
  "name": "akkal-dark-theme",
  "displayName": "Akkal Dark Theme",
  "description": "A collection of dark themes for Visual Studio Code, built around the colors and styles I enjoy using every day. These are my favorite themes, forked and adjusted to match my personal taste.",
  "version": "1.0.9",
  "publisher": "akkal",
  "license": "MIT",
  "icon": "icon.png",
  "scripts": {
    "version:patch": "npm version patch --no-git-tag-version",
    "package": "vsce package --baseImagesUrl https://akkal.com.np/vscode/akkal-dark/screenshots",
    "publish": "vsce publish --baseImagesUrl https://akkal.com.np/vscode/akkal-dark/screenshots"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "akkal dark theme",
    "akkal midnight theme",
    "akkal midnight",
    "akkal dark",
    "akkal dark pro",
    "akkal dark pro theme",
    "dark theme",
    "vscode theme",
    "one dark",
    "one dark pro",
    "one dark pro theme",
    "dark pro theme",
    "vesper dark",
    "vesper dark theme",
    "vesper theme",
    "developer theme",
    "syntax highlighting",
    "ayu dark",
    "ayu dark pro"
  ],
  "galleryBanner": {
    "color": "#21252B",
    "theme": "dark"
  },
  "preview": true,
  "contributes": {
    "themes": [
      {
        "label": "Akkal Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/Akkal Dark.json"
      },
      {
        "label": "Akkal Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/Akkal Midnight.json"
      },
      {
        "label": "Vesper Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/Vesper Dark.json"
      },
      {
        "label": "Vesper Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/Vesper Midnight.json"
      },
      {
        "label": "Ayu Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/Ayu Dark.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/akkaldhami/akkal-dark-theme.git"
  }
}
